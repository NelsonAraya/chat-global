# Copia este archivo a ".env" y completa los datos de tu servidor MySQL.
# El archivo ".env" NO se sube a git (contiene credenciales).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_cormudesi

# Opcional: puertos del servidor (si no se definen, usa 3000 y 3443)
# HTTP_PORT=3000
# HTTPS_PORT=3443

# Correo para el botón de alerta (opcional). Si dejas esto vacío, el botón de
# alerta sigue funcionando normal (en pantalla) pero no manda correo.
# SMTP_HOST: servidor SMTP de quien ENVÍA el correo (ej: smtp.gmail.com, smtp.office365.com,
#   o el servidor de correo de CORMUDESI).
# SMTP_USER / SMTP_PASSWORD: la cuenta que envía. Si usas Gmail con verificación en 2 pasos,
#   necesitas una "contraseña de aplicación" (no tu contraseña normal).
# ALERT_EMAIL_FROM: remitente que verán en el correo (si lo dejas vacío, usa SMTP_USER).
# ALERT_EMAIL_TO: quién(es) reciben la alerta. Puede ser más de un correo separado por comas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
