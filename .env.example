# Copia este archivo a ".env" y completa los datos de tu servidor MySQL.
# El archivo ".env" NO se sube a git (contiene credenciales).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_cormudesi

# Opcional: conexiones simultáneas a MySQL (por defecto 30; MySQL acepta 151 por defecto)
# DB_POOL_SIZE=30

# Opcional: dominios de correo aceptados al registrarse / activar el doble factor,
# separados por comas (si no se define, acepta solo cormudesi.cl y gmail.com).
# ALLOWED_EMAIL_DOMAINS=cormudesi.cl,gmail.com

# ===== Red local (por defecto) =====
# El chat sirve HTTPS con su propio certificado. Puertos (si no se definen, usa 3000 y 3443):
# HTTP_PORT=3000
# HTTPS_PORT=3443

# ===== Web (internet) =====
# Con MODO_WEB=true el chat queda detrás de Nginx (paso a paso en INSTALACION-WEB.md):
# escucha HTTP solo dentro del servidor, no genera certificado ni ofrece descargarlo, y solo
# acepta conexiones desde DOMINIO. Los HTTP_PORT/HTTPS_PORT de arriba no se usan.
# MODO_WEB=true
# DOMINIO=aurora.cormudesi.cl
# WEB_HOST=127.0.0.1          # no cambiar: así el chat no queda expuesto sin pasar por Nginx
# WEB_PORT=3000               # puerto interno al que Nginx envía las conexiones
# PROXY_IPS=                  # solo si Nginx está en OTRO equipo: su IP (para saber la IP real de cada usuario)

# Cuenta "admin" en una instalación NUEVA (en modo web es obligatoria, 8 caracteres o más).
# Con ADMIN_EMAIL_INICIAL el código de doble factor llega a ese correo desde el primer ingreso.
# ADMIN_PASSWORD_INICIAL=
# ADMIN_EMAIL_INICIAL=

# Zona horaria para la fecha de los correos de alerta (por defecto Chile).
# ZONA_HORARIA=America/Santiago

# Correo (SMTP). Se usa para el botón de alerta y para enviar el código de acceso
# del doble factor (vence en 5 minutos). Si SMTP no está configurado, el código de
# acceso se muestra en la consola del servidor para que un administrador lo entregue.
# El botón de alerta sigue funcionando normal (en pantalla) aunque no haya correo.
# SMTP_HOST: servidor SMTP de quien ENVÍA el correo (ej: smtp.gmail.com, smtp.office365.com,
#   o el servidor de correo de CORMUDESI).
# SMTP_USER / SMTP_PASSWORD: la cuenta que envía. Si usas Gmail con verificación en 2 pasos,
#   necesitas una "contraseña de aplicación" (no tu contraseña normal).
# ALERT_EMAIL_FROM: remitente que verán en el correo (si lo dejas vacío, usa SMTP_USER).
# ALERT_EMAIL_TO: quién(es) reciben la alerta. Puede ser más de un correo separado por comas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
